# App configuration (the single config file the assignment asks for).
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The app loads .env as a Flutter asset, so its contents are packed INSIDE the APK.
# Never put a private key or seed phrase in this file (see ATURAN.md section 4).
# RPC_URL and CONTRACT_ADDRESS are defaults; the app's Koneksi screen can override them without a rebuild.

# Sepolia RPC endpoint. A provider URL (Alchemy/Infura) contains your API key, so keep it here,
# not in code. A public endpoint also works, e.g. https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=

# LogbookAlat contract address on Sepolia (public; filled in after deployment)
CONTRACT_ADDRESS=

# Sepolia chain ID. The app refuses to run against any other chain.
CHAIN_ID=11155111

# Optional: a loan open longer than this many hours is shown as overdue (default 24).
LOAN_LIMIT_HOURS=24
